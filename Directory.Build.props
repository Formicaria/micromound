<Project>
  <!--
    Shared build settings for every MICROMOUND .NET project, mirroring ANTHILL's
    Directory.Build.props so the two solutions stay convention-compatible.
  -->
  <PropertyGroup>
    <!--
      net10.0 since v0.9.36 (roadmap P0.10). .NET 9 is STS and leaves support on 10 November 2026;
      .NET 10 is LTS to 14 November 2028. The LANGUAGE version deliberately stays at 13: this slice
      is a runtime move, and a runtime move must not change a signed byte, so nothing about how the
      code is written changes with it. C# 14 is a separate decision, on its own merits.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!--
      Versioning after v0.9.0: the line continues as PATCH releases — v0.9.1, v0.9.2, …
      Each is a small, self-contained hardening, cleanup, or foundation slice. v0.10.0 is reserved
      for the meaningful M4 milestone BOUNDARY — the headless host actually running on a real device
      over real disk and real drivers — not claimed for the internal substrate pieces that lead up
      to it, and never just because it is the numeric successor to v0.9.x. The release scripts read
      this value literally and never assume the next release; bump it here by hand per slice.
    -->
    <MicromoundVersion>0.9.42</MicromoundVersion>
    <Version>$(MicromoundVersion)</Version>
    <Authors>ANTHILL Project</Authors>
    <Product>MICROMOUND</Product>
  </PropertyGroup>
</Project>
